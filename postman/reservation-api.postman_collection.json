                  "});",
                  "pm.test('el filtro deja 2 reservas activas de ese día', () => {",
                  "    pm.expect(body.totalElements).to.eql(2);",
                  "    pm.expect(body.totalPages).to.eql(2);",
                  "});",
                  "pm.test('todas son de la sala pedida y ACTIVE', () => {",
                  "    pm.expect(String(body.content[0].roomId)).to.eql(String(pm.collectionVariables.get('roomId')));",
