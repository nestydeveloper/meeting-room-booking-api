        {
          "name": "1.1 Listar salas (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve un array de salas', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    if (body.length > 1) {",
                  "        const names = body.map(room => room.name);",
                  "        const sorted = [...names].sort();",
                  "        pm.test('ordenado por nombre', () => pm.expect(names).to.eql(sorted));",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rooms"
              ]
            }
          }
        },
        {
          "name": "1.2 Crear sala (Basic) -> 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nombre único por corrida: la colección se puede repetir sin 409 por duplicado.",
                  "pm.collectionVariables.set('roomName', 'Sala Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location apunta a /api/v1/rooms/{id}', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/v1\\/rooms\\/\\d+$/);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('devuelve id y nombre', () => {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.name).to.eql(pm.collectionVariables.get('roomName'));",
                  "});",
                  "pm.collectionVariables.set('roomId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
