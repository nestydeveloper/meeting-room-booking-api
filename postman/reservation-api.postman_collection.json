          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Content-Type RFC 9457', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('título y status del problem detail', () => {",
                  "    pm.expect(body.status).to.eql(400);",
                  "    pm.expect(body.title).to.eql('Bad Request');",
                  "    pm.expect(body.instance).to.eql('/api/v1/rooms');",
                  "});",
                  "pm.test('error de campo claro en errors[]', () => {",
                  "    pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body.errors[0].field).to.eql('name');",
                  "    pm.expect(body.errors[0].message).to.be.a('string').and.not.empty;",
                  "});"
                ]
